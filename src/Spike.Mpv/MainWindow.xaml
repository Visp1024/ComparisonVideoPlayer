<Window x:Class="Spike.Mpv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:Spike.Mpv.Interop"
        Title="Спайк libmpv — покадровый шаг, два плеера" Height="720" Width="1280"
        Background="#202020">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <interop:MpvHost x:Name="HostA" Grid.Column="0" Margin="4" />
            <interop:MpvHost x:Name="HostB" Grid.Column="1" Margin="4" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6">
            <Button Content="Открыть A…" Click="OpenA_Click" Margin="0,0,6,0" Padding="8,4" />
            <Button Content="Открыть B…" Click="OpenB_Click" Margin="0,0,16,0" Padding="8,4" />
            <Button Content="◀ кадр" Click="StepPrev_Click" Margin="0,0,6,0" Padding="8,4" />
            <Button Content="кадр ▶" Click="StepNext_Click" Margin="0,0,6,0" Padding="8,4" />
            <Button Content="Play/Pause" Click="PlayPause_Click" Margin="0,0,16,0" Padding="8,4" />
            <Button x:Name="BtnBench" Content="Прогнать замеры" Click="Bench_Click" Padding="8,4" />
            <TextBlock x:Name="TxtPos" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <TextBox x:Name="TxtLog" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#101010" Foreground="#C0C0C0" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
