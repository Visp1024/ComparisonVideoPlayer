<chrome:AppWindow x:Class="ComparisonPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:tl="clr-namespace:ComparisonPlayer.Timeline"
        xmlns:chrome="clr-namespace:ComparisonPlayer.Chrome"
        Title="CVP" Icon="app.ico" Height="820" Width="1320"
        MinHeight="520" MinWidth="960"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Своя титульная полоса (задача #21): родная шапка Windows светлая и спорит
             с почти чёрным кадром. По центру — что открыто: сейчас это единственное
             место, где имена файлов видны, не наводя глаз на метки поверх кадра. -->
        <chrome:TitleBar x:Name="Bar" Grid.Row="0" Caption="CVP" />

        <!-- Панель инструментов -->
        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnOpenA" Style="{StaticResource PrimaryButton}" Click="OpenA_Click"
                        ToolTip="Открыть файл в трек A (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Открыть A" />
                        <TextBlock Text="Ctrl+O" Margin="8,0,0,0" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOpenB" Style="{StaticResource ToolButton}" Click="OpenB_Click"
                        Foreground="{StaticResource TrackBBrush}" BorderBrush="{StaticResource TrackBDim}"
                        ToolTip="Открыть файл в трек B (Ctrl+Shift+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Открыть B" />
                        <TextBlock Text="Ctrl+Shift+O" Margin="8,0,0,0" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource ToolButton}" Content="Закрыть" Click="Close_Click"
                        ToolTip="Закрыть файл активного трека" />

                <!-- Сессия (фаза 5): пара роликов с выравниванием и отрезками — результат
                     ручной работы, и он переживает закрытие окна -->
                <Button x:Name="BtnSession" Style="{StaticResource ToolButton}" Content="Сессия…"
                        Click="Session_Click" ToolTip="Сохранить, открыть или восстановить сессию сравнения">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SessionMenu" Background="{StaticResource Panel2Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource LineBrush}">
                            <MenuItem Header="Сохранить сессию…  Ctrl+S" Click="SessionSave_Click" />
                            <MenuItem Header="Открыть сессию…" Click="SessionOpen_Click" />
                            <Separator />
                            <MenuItem Header="Восстановить последнюю" Click="SessionRestore_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="BtnInfo" Style="{StaticResource ToolButton}" Content="Сведения" Click="Info_Click"
                        ToolTip="Сведения о файле (Ctrl+I)" />
                <Button x:Name="BtnLayout" Style="{StaticResource ToolButton}" Content="Рядом" Click="Layout_Click"
                        ToolTip="Что показывать: рядом / только A / только B (V)" />

                <!-- Пауза при переходе по таймлайну (задача #29): настройка живёт и в окне
                     настроек, но её меняют по ходу просмотра, поэтому флажок стоит здесь -->
                <CheckBox x:Name="ChkPauseOnSeek" VerticalAlignment="Center" Margin="16,0,0,0"
                          Content="Пауза при переходе" Click="PauseOnSeek_Click"
                          ToolTip="Ставить на паузу при переходе по таймлайну: щелчок по шкале, перетаскивание playhead, Home/End. Выключено — воспроизведение продолжается с нового места." />

                <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Content="Настройки" Margin="8,0,0,0" Click="Settings_Click"
                        ToolTip="Настройки и шпаргалка по клавишам (F1)" />

                <!-- Кэш кадров: индикаторы режима по треку и панель управления -->
                <Button x:Name="BtnCache" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Content="Кэш…" Margin="8,0,0,0" Click="Cache_Click"
                        ToolTip="Режим кэша кадров, объём хранилища (C)" />

                <!-- Внешнее управление из Unity (задача #9): подсветка кнопки — включено ли
                     оно, цвет точки — есть ли клиент на том конце -->
                <Button x:Name="BtnUnity" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Margin="8,0,0,0" Click="Unity_Click"
                        ToolTip="Внешнее управление плеером из Unity">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="UnityDot" Width="7" Height="7" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Fill="{StaticResource DimBrush}" />
                        <TextBlock Text="Unity" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnBuildCancel" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Content="Отменить" Margin="8,0,0,0" Visibility="Collapsed" Click="CacheCancel_Click"
                        ToolTip="Остановить сборку кэша" />

                <Border x:Name="ModeBadgeB" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDotB" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource DimBrush}" />
                        <TextBlock x:Name="ModeTextB" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}" Text="B —" />
                    </StackPanel>
                </Border>

                <Border x:Name="ModeBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource DimBrush}" />
                        <TextBlock x:Name="ModeText" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Text="файл не открыт" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Кадры и боковая панель.
             Панели «Сведения» и «Кэш…» фаз 1 и 4 были накладками поверх кадра: при двух
             окнах вывода FlyleafLib накладка одного трека закрывала бы второй кадр,
             поэтому теперь это колонка сбоку. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Stage" Grid.Column="0" Background="{StaticResource VideoBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneAColumn" Width="*" />
                    <ColumnDefinition x:Name="PaneBColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Трек A -->
                <Border x:Name="PaneA" Grid.Column="0" Background="{StaticResource VideoBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                    <fl:FlyleafHost x:Name="VideoHostA"
                                    VideoBackground="{StaticResource VideoBrush}"
                                    KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                    ToggleFullScreenOnDoubleClick="None">
                        <Grid x:Name="OverlayA" Background="Transparent" AllowDrop="True">

                            <Grid x:Name="EmptyA" Background="{StaticResource VideoBrush}">
                                <Border x:Name="DropFrameA" Margin="18" CornerRadius="6"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="DropTitleA" Text="Трек A пуст"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DropHintA"
                                                   Text="перетащите видео сюда · mp4, mkv, mov, avi, ts"
                                                   FontSize="13" Margin="0,10,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Кадра нет: сдвиг увёл трек за край материала или за отрезок -->
                            <Grid x:Name="NoFrameA" Background="{StaticResource VideoBrush}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="нет кадра" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="NoFrameHintA" FontSize="12.5" Margin="0,6,0,0"
                                               Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Метка трека: видна всегда, иначе не понять, где какой файл -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"
                                    Panel.ZIndex="2" CornerRadius="4" Padding="9,4" Background="#A8050709">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="A" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                               FontSize="13" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="PaneNameA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="#F3F5FA" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PaneOsdA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="PaneMasterA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="{StaticResource DimBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </fl:FlyleafHost>
                </Border>

                <!-- Трек B -->
                <Border x:Name="PaneB" Grid.Column="1" Background="{StaticResource VideoBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                    <fl:FlyleafHost x:Name="VideoHostB"
                                    VideoBackground="{StaticResource VideoBrush}"
                                    KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                    ToggleFullScreenOnDoubleClick="None">
                        <Grid x:Name="OverlayB" Background="Transparent" AllowDrop="True">

                            <Grid x:Name="EmptyB" Background="{StaticResource VideoBrush}">
                                <Border x:Name="DropFrameB" Margin="18" CornerRadius="6"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="DropTitleB" Text="Трек B пуст"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DropHintB"
                                                   Text="перетащите сюда второй ролик"
                                                   FontSize="13" Margin="0,10,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="NoFrameB" Background="{StaticResource VideoBrush}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="нет кадра" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="NoFrameHintB" FontSize="12.5" Margin="0,6,0,0"
                                               Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"
                                    Panel.ZIndex="2" CornerRadius="4" Padding="9,4" Background="#A8050709">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="B" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                               FontSize="13" Foreground="{StaticResource TrackBBrush}" />
                                    <TextBlock x:Name="PaneNameB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="#F3F5FA" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PaneOsdB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="{StaticResource TrackBBrush}" />
                                    <TextBlock x:Name="PaneMasterB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5" Foreground="{StaticResource DimBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </fl:FlyleafHost>
                </Border>
            </Grid>

            <!-- Боковая панель: «Сведения» и «Кэш…» с вкладками A / B -->
            <Border x:Name="SidePanel" Grid.Column="1" Width="340" Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="SideTitle" Text="С В Е Д Е Н И Я"
                                       Style="{StaticResource PanelHeader}" Margin="0" VerticalAlignment="Center" />
                            <Button Content="✕" Click="SideClose_Click" Style="{StaticResource ToolButton}"
                                    HorizontalAlignment="Right" Margin="0" Padding="7,1" FontSize="11"
                                    ToolTip="Свернуть панель" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="TabA" Style="{StaticResource TrackTab}" GroupName="SideTrack"
                                         Content="A" Checked="SideTab_Checked" Tag="A" />
                            <RadioButton x:Name="TabB" Style="{StaticResource TrackTab}" GroupName="SideTrack"
                                         Content="B" Checked="SideTab_Checked" Tag="B" />
                        </StackPanel>

                        <!-- Сведения -->
                        <StackPanel x:Name="InfoSection">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Файл" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoFile"
                                           Style="{StaticResource PanelValue}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Кодек" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoCodec" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Размер" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoSize" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Частота" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoFps" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Режим" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoRate" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Длительность" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoDuration" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Кадров" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InfoFrames" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Кадры из" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InfoSource" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Роль" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="InfoRole" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Звук" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" x:Name="InfoAudio" Style="{StaticResource PanelValue}" />
                            </Grid>

                            <TextBlock x:Name="InfoProxyNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />

                            <TextBlock x:Name="InfoVfrNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"
                                       Text="Переменная частота кадров: номер кадра вычисляется по времени и может отличаться от нумерации в других программах." />
                        </StackPanel>

                        <!-- Кэш кадров -->
                        <StackPanel x:Name="CacheSection" Visibility="Collapsed">
                            <TextBlock Text="Р Е Ж И М   К Э Ш А" Style="{StaticResource PanelHeader}" />

                            <RadioButton x:Name="RbAuto" Style="{StaticResource CacheRadio}"
                                         Content="Автоматически" Checked="CacheMode_Checked" Tag="Auto" />
                            <TextBlock x:Name="RbAutoHint" Style="{StaticResource PanelHint}"
                                       Text="строить, если шаг назад медленнее 250 мс" />

                            <RadioButton x:Name="RbAlways" Style="{StaticResource CacheRadio}"
                                         Content="Всегда — для любого открытого файла"
                                         Checked="CacheMode_Checked" Tag="Always" />

                            <RadioButton x:Name="RbNever" Style="{StaticResource CacheRadio}"
                                         Content="Никогда — только прямой декод"
                                         Checked="CacheMode_Checked" Tag="Never" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                            <TextBlock Text="Ч А С Т О Т А   П Р О К С И" Style="{StaticResource PanelHeader}" />
                            <WrapPanel x:Name="CacheFpsChips">
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="0"
                                             Content="как в исходнике" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="60"
                                             Content="60" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="50"
                                             Content="50" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="30"
                                             Content="30" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="25"
                                             Content="25" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="24"
                                             Content="24" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="15"
                                             Content="15" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="12"
                                             Content="12" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="10"
                                             Content="10" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="5"
                                             Content="5" Checked="CacheFps_Checked" />
                            </WrapPanel>
                            <TextBlock x:Name="CacheFpsHint" Style="{StaticResource PanelHint}" Margin="0,1,0,4"
                                       Text="ниже исходной — кэш меньше и собирается быстрее, но кадры прореживаются, а их номера становятся номерами прокси" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                            <TextBlock x:Name="CacheFileHeader" Text="Т Р Е К   A"
                                       Style="{StaticResource PanelHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Режим" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CacheFileMode" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг назад" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CacheFileStep" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Прокси" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheFileProxy" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Собран" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CacheFileBuilt" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Звук" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CacheFileAudio" Style="{StaticResource PanelValue}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnRebuild" Style="{StaticResource ToolButton}"
                                        Content="Собрать заново" Click="CacheRebuild_Click" />
                                <Button x:Name="BtnUseSource" Style="{StaticResource ToolButton}"
                                        Content="Играть с исходника" Click="CacheUseSource_Click" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                            <TextBlock Text="Х Р А Н И Л И Щ Е" Style="{StaticResource PanelHeader}" />
                            <TextBlock x:Name="CacheStorageText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,7" />
                            <ProgressBar x:Name="CacheStorageBar" Style="{StaticResource CacheProgressBar}" Value="0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ToolButton}" Content="Открыть папку" Click="CacheOpenFolder_Click" />
                                <Button Style="{StaticResource ToolButton}" Content="Очистить всё" Click="CacheClear_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Таймлайн: панель управления и сам контрол (линейка, дорожки, playhead).
             В компактном виде (задача #18) вся эта область скрыта, вместо неё —
             подвал строкой ниже. -->
        <Grid x:Name="TimelineArea" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1" Padding="12,6">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnZoomOut" Style="{StaticResource TimelineButton}" Content="−"
                            Click="ZoomOut_Click" ToolTip="Отдалить (−)" />
                    <TextBlock x:Name="TxtZoom" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" MinWidth="76" />
                    <Button x:Name="BtnZoomIn" Style="{StaticResource TimelineButton}" Content="+"
                            Click="ZoomIn_Click" ToolTip="Приблизить (+)" />
                    <Button x:Name="BtnFit" Style="{StaticResource TimelineButton}" Content="Уместить"
                            Click="Fit_Click" ToolTip="Вся шкала в ширину окна (F)" />
                    <Button x:Name="BtnSnap" Style="{StaticResource TimelineButton}" Content="Снэп"
                            Click="Snap_Click" ToolTip="Притягивать playhead, ручки и клипы к границам (S)" />
                    <Button x:Name="BtnMaster" Style="{StaticResource TimelineButton}" Content="Мастер: A"
                            Click="Master_Click" ToolTip="Чьими кадрами меряется шаг — активный трек становится мастером (M)" />

                    <!-- Сдвиг второго трека: перетаскивание клипа задаёт его грубо,
                         это поле и Alt+стрелки — покадрово -->
                    <TextBlock Text="сдвиг B" Margin="8,0,6,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="BtnOffsetDown" Style="{StaticResource TimelineButton}" Content="−"
                            Margin="0,0,4,0" Click="OffsetDown_Click" ToolTip="Сдвинуть B на кадр назад (Alt+←)" />
                    <TextBox x:Name="TxtOffset" Style="{StaticResource SpeedBox}" Text="0" Width="62"
                             Foreground="{StaticResource TrackBBrush}" CaretBrush="{StaticResource TrackBBrush}"
                             KeyDown="Offset_KeyDown" LostFocus="Offset_LostFocus"
                             ToolTip="Сдвиг трека B в кадрах мастера: введите число и нажмите Enter" />
                    <Button x:Name="BtnOffsetUp" Style="{StaticResource TimelineButton}" Content="+"
                            Margin="4,0,6,0" Click="OffsetUp_Click" ToolTip="Сдвинуть B на кадр вперёд (Alt+→)" />
                    <Button x:Name="BtnOffsetReset" Style="{StaticResource TimelineButton}" Content="Сбросить сдвиг"
                            Click="OffsetReset_Click" ToolTip="Совместить начала треков (Alt+0)" />

                    <Button x:Name="BtnCollapse" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="▾" Margin="10,0,0,0" Padding="9,1" Click="ToggleCompact_Click"
                            ToolTip="Свернуть до полосы прогресса (Ctrl+T)" />

                    <TextBlock x:Name="TxtSegment" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="BtnLoop" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Петля" Margin="0" Click="Loop_Click"
                            ToolTip="Повторять отрезок при воспроизведении (Ctrl+L)" />
                    <Button x:Name="BtnSegReset" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Сбросить" Click="SegmentReset_Click"
                            ToolTip="Отрезок активного трека на весь ролик (Shift+I)" />
                    <Button x:Name="BtnOut" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Конец отрезка" Click="SetOut_Click"
                            ToolTip="Конец отрезка на текущем кадре (O)" />
                    <Button x:Name="BtnIn" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Начало отрезка" Click="SetIn_Click"
                            ToolTip="Начало отрезка на текущем кадре (I)" />
                </DockPanel>
            </Border>

            <tl:TimelineControl x:Name="Timeline" Grid.Row="1" Margin="12,0,12,4" />
        </Grid>

        <!-- Компактный подвал (задача #18): полоса прогресса во всю ширину, под ней
             полоска инициализации кэша и ужатый транспорт. Заменяет собой и таймлайн,
             и полноразмерный транспорт, и строку сообщений. -->
        <Border x:Name="CompactFooter" Grid.Row="4" Visibility="Collapsed"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8,12,6">
            <StackPanel>
                <tl:CompactBar x:Name="MiniBar" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTimeMini" FontFamily="{StaticResource MonoFont}" FontSize="13.5"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDurationMini" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnShuttleBackMini" Style="{StaticResource MiniTransportButton}" Content="◀◀"
                                Click="ShuttleBack_Click" ToolTip="Шаттл назад (J)" />
                        <Button x:Name="BtnPrevMini" Style="{StaticResource MiniTransportButton}" Content="◀|"
                                Click="StepPrev_Click" ToolTip="Шаг на кадр назад (←)" />
                        <Button x:Name="BtnPlayMini" Style="{StaticResource MiniPlayButton}" Content="▶"
                                Click="PlayPause_Click" ToolTip="Воспроизведение / пауза (Space)" />
                        <Button x:Name="BtnNextMini" Style="{StaticResource MiniTransportButton}" Content="|▶"
                                Click="StepNext_Click" ToolTip="Шаг на кадр вперёд (→)" />
                        <Button x:Name="BtnShuttleFwdMini" Style="{StaticResource MiniTransportButton}" Content="▶▶"
                                Click="ShuttleForward_Click" ToolTip="Шаттл вперёд (L)" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFrameAMini" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="TxtFrameBMini" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TrackBBrush}" />
                        <!-- Звук и в свёрнутом виде правится целиком: громкость нужна не
                             реже транспорта, а разворачивать таймлайн ради неё незачем -->
                        <Button x:Name="BtnMuteMini" Style="{StaticResource TimelineButton}" Content="🔊"
                                Margin="10,0,6,0" Padding="7,1" Click="Mute_Click"
                                ToolTip="Звук мастер-трека: включить или выключить (Ctrl+M)" />
                        <Slider x:Name="VolumeSliderMini" Style="{StaticResource VolumeSlider}" Width="72"
                                ValueChanged="Volume_Changed"
                                ToolTip="Громкость звучащего трека (Ctrl+↑ / Ctrl+↓)" />
                        <TextBlock x:Name="TxtVolumeMini" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="34"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Button x:Name="BtnExpand" Style="{StaticResource TimelineButton}" Content="▴"
                                Margin="10,0,0,0" Padding="9,1" Click="ToggleCompact_Click"
                                ToolTip="Развернуть таймлайн (Ctrl+T)" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Транспорт.
             WrapPanel, а не StackPanel: с появлением громкости (задача #20) содержимое
             перестало помещаться в окно наименьшей ширины, а обрезанный ползунок хуже
             перенесённого на вторую строку. -->
        <WrapPanel x:Name="TransportRow" Grid.Row="5" Orientation="Horizontal" Margin="14,10,14,12"
                   VerticalAlignment="Center">
            <Button x:Name="BtnShuttleBack" Style="{StaticResource TransportButton}" Content="◀◀"
                    Click="ShuttleBack_Click" ToolTip="Шаттл назад: повторное нажатие вдвое быстрее (J)" />
            <Button x:Name="BtnPrev" Style="{StaticResource TransportButton}" Content="◀|" Click="StepPrev_Click"
                    ToolTip="Шаг на кадр назад (←); с Shift — крупный шаг" />
            <Button x:Name="BtnPlay" Style="{StaticResource PlayButton}" Content="▶" Click="PlayPause_Click"
                    ToolTip="Воспроизведение / пауза (Space); K останавливает шаттл" />
            <Button x:Name="BtnNext" Style="{StaticResource TransportButton}" Content="|▶" Click="StepNext_Click"
                    ToolTip="Шаг на кадр вперёд (→); с Shift — крупный шаг" />
            <Button x:Name="BtnShuttleFwd" Style="{StaticResource TransportButton}" Content="▶▶"
                    Click="ShuttleForward_Click" ToolTip="Шаттл вперёд: повторное нажатие вдвое быстрее (L)" />

            <TextBlock x:Name="TxtTime" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="19" />
            <TextBlock x:Name="TxtDuration" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="14"
                       Foreground="{StaticResource DimBrush}" />

            <Border x:Name="FrameBadgeA" Margin="14,0,0,0" Padding="8,2" CornerRadius="4"
                    BorderBrush="{StaticResource AccentDim}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFrameA" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
            <Border x:Name="FrameBadgeB" Margin="8,0,0,0" Padding="8,2" CornerRadius="4"
                    BorderBrush="{StaticResource TrackBDim}" BorderThickness="1" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtFrameB" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource TrackBBrush}" />
            </Border>

            <Button x:Name="BtnStart" Style="{StaticResource ToolButton}" Content="В начало" Margin="16,0,0,0"
                    Click="ToStart_Click" ToolTip="Начало отрезка (Home); Shift+Home — начало шкалы" />

            <!-- Скорость воспроизведения: на шаг и seek не влияет, только на ход
                 воспроизведения; задаётся обоим трекам одинаковой. -->
            <TextBlock Text="скорость" Margin="10,0,8,0" VerticalAlignment="Center"
                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
            <Button x:Name="BtnSpeedDown" Style="{StaticResource TimelineButton}" Content="−"
                    Margin="0,0,4,0" Click="SpeedDown_Click" ToolTip="Медленнее на 0,25×" />
            <TextBox x:Name="TxtSpeed" Style="{StaticResource SpeedBox}" Text="1"
                     KeyDown="Speed_KeyDown" LostFocus="Speed_LostFocus"
                     ToolTip="Скорость воспроизведения: введите число и нажмите Enter" />
            <Button x:Name="BtnSpeedUp" Style="{StaticResource TimelineButton}" Content="+"
                    Margin="4,0,0,0" Click="SpeedUp_Click" ToolTip="Быстрее на 0,25×" />

            <!-- Звук (задача #20): звучит только мастер-трек, ведомый приглушён всегда,
                 иначе два ролика накладывались бы друг на друга. -->
            <Button x:Name="BtnMute" Style="{StaticResource TimelineButton}" Content="🔊"
                    Margin="14,0,8,0" Click="Mute_Click"
                    ToolTip="Звук мастер-трека: включить или выключить (Ctrl+M)" />
            <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="96"
                    ValueChanged="Volume_Changed"
                    ToolTip="Громкость звучащего трека (Ctrl+↑ / Ctrl+↓)" />
            <TextBlock x:Name="TxtVolume" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"
                       FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       Foreground="{StaticResource MutedBrush}" />
        </WrapPanel>

        <!-- Строка сообщений: в компактном виде скрыта вместе с таймлайном -->
        <Border x:Name="StatusBar" Grid.Row="6" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="TxtStatus" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</chrome:AppWindow>
