<chrome:AppWindow x:Class="ComparisonPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="clr-namespace:ComparisonPlayer.Timeline"
        xmlns:chrome="clr-namespace:ComparisonPlayer.Chrome"
        xmlns:loc="clr-namespace:ComparisonPlayer.Localization"
        Title="CVP" Icon="app.ico" Height="820" Width="1320"
        MinHeight="520" MinWidth="960"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Своя титульная полоса (задача #21): родная шапка Windows светлая и спорит
             с почти чёрным кадром. По центру — что открыто: сейчас это единственное
             место, где имена файлов видны, не наводя глаз на метки поверх кадра. -->
        <chrome:TitleBar x:Name="Bar" Grid.Row="0" Caption="CVP" />

        <!-- Панель инструментов (задача #32).
             Одиннадцать подписей читались как список, а не как инструмент, и в узком
             окне не помещались. Теперь: открытие файлов и сессия — под «Файл»,
             настройки — под шестерёнкой, остальное — иконки с подсказками. -->
        <Border x:Name="Toolbar" Grid.Row="1" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,7">
            <DockPanel LastChildFill="False">
                <!-- Меню «Файл»: открытие роликов, закрытие трека и сессия сравнения
                     (фаза 5) — всё это про файлы, отдельная кнопка на каждое съедала
                     половину панели -->
                <Button x:Name="BtnFile" Style="{StaticResource MenuBarButton}" Content="{loc:Str Toolbar.File}"
                        Tag="{StaticResource IcoFolder}" Click="File_Click"
                        ToolTip="{loc:Str Toolbar.FileTip}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="FileMenu">
                            <MenuItem Header="{loc:Str Menu.OpenA}" InputGestureText="Ctrl+O" Click="OpenA_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoFolder}"
                                          Stroke="{StaticResource AccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Menu.OpenB}" InputGestureText="Ctrl+Shift+O" Click="OpenB_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoFolder}"
                                          Stroke="{StaticResource TrackBBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MnuClose" Header="{loc:Str Menu.CloseTrack}" Click="Close_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoClose}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{loc:Str Menu.SessionSave}" InputGestureText="Ctrl+S" Click="SessionSave_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoSave}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Menu.SessionOpen}" Click="SessionOpen_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoFolder}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Menu.SessionRestore}" Click="SessionRestore_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoClockFull}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Border Width="1" Margin="4,2,10,2" Background="{StaticResource LineBrush}" />

                <!-- Раскладка таблеткой: кнопка по кругу не показывала, между чем выбор.
                     Видна всегда, в том числе на одном ролике (задача #38): недостающий
                     трек только гасит свой сегмент — «только B» вело бы в пустой экран. -->
                <Border x:Name="LayoutPill" Style="{StaticResource SegPill}"
                        ToolTip="{loc:Str Toolbar.LayoutTip}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegLayoutA" Style="{StaticResource SegText}" GroupName="Layout"
                                     Content="A" Checked="Layout_Checked" />
                        <RadioButton x:Name="SegLayoutBoth" Style="{StaticResource SegIcon}" GroupName="Layout"
                                     Content="{StaticResource IcoPanes}" Checked="Layout_Checked" />
                        <RadioButton x:Name="SegLayoutB" Style="{StaticResource SegText}" GroupName="Layout"
                                     Content="B" Tag="{StaticResource TrackBBrush}" Checked="Layout_Checked" />
                    </StackPanel>
                </Border>

                <!-- Как кадр вписан в область (задача #28): вписать / заполнить / растянуть -->
                <Button x:Name="BtnScale" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IcoScaleFit}" Click="Scale_Click"
                        ToolTip="{loc:Str Toolbar.ScaleTip}" />

                <!-- Накладка над кадром: имя файла, таймкод и номер кадра в левом верхнем
                     углу. Клавиша T была единственным способом её убрать (задача #32). -->
                <Button x:Name="BtnOverlay" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IcoOverlay}" Click="Overlay_Click"
                        ToolTip="{loc:Str Toolbar.OverlayTip}" />

                <Border Width="1" Margin="4,2,10,2" Background="{StaticResource LineBrush}" />

                <Button x:Name="BtnInfo" Style="{StaticResource IconButton}" Tag="{StaticResource IcoInfo}"
                        Click="Info_Click" ToolTip="{loc:Str Toolbar.InfoTip}" />

                <Button x:Name="BtnFullScreen" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IcoFullscreen}" Margin="6,0,0,0" Click="FullScreen_Click"
                        ToolTip="{loc:Str Toolbar.FullscreenTip}" />

                <!-- Шестерёнка: флажок «Пауза при переходе» занимал в панели больше места,
                     чем любая кнопка, а трогают его редко -->
                <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{StaticResource MenuBarButton}"
                        Tag="{StaticResource IcoGear}" Margin="6,0,0,0" Padding="7,5" Click="Settings_Click"
                        ToolTip="{loc:Str Toolbar.SettingsTip}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SettingsMenu">
                            <MenuItem x:Name="MnuPauseOnSeek" IsCheckable="True"
                                      Header="{loc:Str Menu.PauseOnSeek}" Click="PauseOnSeek_Click"
                                      ToolTip="{loc:Str Menu.PauseOnSeekTip}" />
                            <Separator />
                            <MenuItem Header="{loc:Str Menu.Settings}" InputGestureText="Ctrl+," Click="SettingsOpen_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoGear}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Menu.Keys}" InputGestureText="F1" Click="SettingsKeys_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIcon}" Data="{StaticResource IcoInfo}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Внешнее управление из Unity (задача #9): подсветка кнопки — включено ли
                     оно, цвет точки — есть ли клиент на том конце -->
                <Button x:Name="BtnUnity" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Margin="6,0,0,0" Padding="7,4" Click="Unity_Click"
                        ToolTip="{loc:Str Toolbar.UnityTip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="UnityDot" Width="7" Height="7" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Fill="{StaticResource DimBrush}" />
                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                            <Canvas Width="20" Height="20">
                                <Path Data="{StaticResource IcoCube}" Stretch="None" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Button>

                <!-- Кэш кадров: панель управления. Кнопка стоит справа, рядом с Unity
                     (задача #38): кэш — про хранилище и служебные режимы, а не про то,
                     как показан кадр, — и слева от неё через разделитель уже стоят её
                     собственные индикаторы режима и остановка сборки. -->
                <Button x:Name="BtnCache" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IcoCache}" Margin="6,0,0,0"
                        Click="Cache_Click" ToolTip="{loc:Str Toolbar.CacheTip}" />

                <Border Width="1" DockPanel.Dock="Right" Margin="10,2,4,2"
                        Background="{StaticResource LineBrush}" />

                <Button x:Name="BtnBuildCancel" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IcoClose}" Margin="6,0,0,0" Visibility="Collapsed"
                        Click="CacheCancel_Click" ToolTip="{loc:Str Toolbar.BuildCancelTip}" />

                <Border x:Name="ModeBadgeB" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDotB" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource DimBrush}" />
                        <TextBlock x:Name="ModeTextB" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}" Text="B —" />
                    </StackPanel>
                </Border>

                <Border x:Name="ModeBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource DimBrush}" />
                        <TextBlock x:Name="ModeText" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Text="{loc:Str Badge.NoFile}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Кадры и боковая панель.
             Панели «Сведения» и «Кэш…» фаз 1 и 4 были накладками поверх кадра: при двух
             окнах вывода FlyleafLib накладка одного трека закрывала бы второй кадр,
             поэтому теперь это колонка сбоку. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Stage" Grid.Column="0" Background="{StaticResource VideoBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneAColumn" Width="*" />
                    <ColumnDefinition x:Name="PaneBColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Трек A -->
                <Border x:Name="PaneA" Grid.Column="0" Background="{StaticResource VideoBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0">
                    <!-- Вывод кадра (FlyleafHost) сюда подставляет код после первого показа окна:
                         в разметке он стоил около 200 мс холодного старта (задача #31).
                         Эта разметка становится накладкой хоста. -->
                    <Grid x:Name="OverlayA" Background="Transparent" AllowDrop="True">

                        <Grid x:Name="EmptyA" Background="{StaticResource VideoBrush}">
                            <Border x:Name="DropFrameA" Margin="18" CornerRadius="6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropTitleA" Text="{loc:Str Stage.TrackAEmpty}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DropHintA"
                                               Text="{loc:Str Stage.DropHintA}"
                                               FontSize="13" Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Кадра нет: сдвиг увёл трек за край материала или за отрезок -->
                        <Grid x:Name="NoFrameA" Background="{StaticResource VideoBrush}" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Str Stage.NoFrame}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NoFrameHintA" FontSize="12.5" Margin="0,6,0,0"
                                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Куда ляжет перетаскиваемый файл (задача #35): над кадром рисовать
                             нечем, кроме накладки хоста, — обычная рамка поверх Stage оказалась
                             бы под окном вывода FlyleafHost. -->
                        <Border x:Name="DropTargetA" Visibility="Collapsed" IsHitTestVisible="False"
                                Panel.ZIndex="3" Margin="10" CornerRadius="6"
                                BorderThickness="3" Background="#33F2A13C"
                                BorderBrush="{StaticResource AccentBrush}">
                            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                    CornerRadius="4" Padding="14,8" Background="#D9050709">
                                <TextBlock x:Name="DropTargetTextA" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </Border>

                        <!-- Метка трека: видна всегда, иначе не понять, где какой файл.
                             Исключение — полноэкранный режим (задача #28): там на экране
                             остаётся только кадр. -->
                        <Border x:Name="PaneLabelA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"
                                Panel.ZIndex="2" CornerRadius="4" Padding="9,4" Background="#A8050709">
                            <StackPanel Orientation="Horizontal">
                                <!-- Буква трека не нужна, когда ролик открыт один: помечать
                                     нечего от чего отличать (задача #32) -->
                                <TextBlock x:Name="PaneLetterA" Text="A" FontFamily="{StaticResource MonoFont}"
                                           FontWeight="Bold"
                                           FontSize="13" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="PaneNameA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="#F3F5FA" MaxWidth="240"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PaneOsdA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="PaneMasterA" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="{StaticResource DimBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Трек B -->
                <Border x:Name="PaneB" Grid.Column="1" Background="{StaticResource VideoBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                    <!-- Вывод кадра (FlyleafHost) сюда подставляет код после первого показа окна:
                         в разметке он стоил около 200 мс холодного старта (задача #31).
                         Эта разметка становится накладкой хоста. -->
                    <Grid x:Name="OverlayB" Background="Transparent" AllowDrop="True">

                        <Grid x:Name="EmptyB" Background="{StaticResource VideoBrush}">
                            <Border x:Name="DropFrameB" Margin="18" CornerRadius="6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropTitleB" Text="{loc:Str Stage.TrackBEmpty}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DropHintB"
                                               Text="{loc:Str Stage.DropHintB}"
                                               FontSize="13" Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="NoFrameB" Background="{StaticResource VideoBrush}" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Str Stage.NoFrame}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NoFrameHintB" FontSize="12.5" Margin="0,6,0,0"
                                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="DropTargetB" Visibility="Collapsed" IsHitTestVisible="False"
                                Panel.ZIndex="3" Margin="10" CornerRadius="6"
                                BorderThickness="3" Background="#334EA3E0"
                                BorderBrush="{StaticResource TrackBBrush}">
                            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                    CornerRadius="4" Padding="14,8" Background="#D9050709">
                                <TextBlock x:Name="DropTargetTextB" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </Border>

                        <Border x:Name="PaneLabelB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"
                                Panel.ZIndex="2" CornerRadius="4" Padding="9,4" Background="#A8050709">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PaneLetterB" Text="B" FontFamily="{StaticResource MonoFont}"
                                           FontWeight="Bold"
                                           FontSize="13" Foreground="{StaticResource TrackBBrush}" />
                                <TextBlock x:Name="PaneNameB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="#F3F5FA" MaxWidth="240"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PaneOsdB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="{StaticResource TrackBBrush}" />
                                <TextBlock x:Name="PaneMasterB" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="{StaticResource DimBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Боковая панель: «Сведения» и «Кэш…» с вкладками A / B -->
            <Border x:Name="SidePanel" Grid.Column="1" Width="340" Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="SideTitle" Text="{loc:Str Side.Info}"
                                       Style="{StaticResource PanelHeader}" Margin="0" VerticalAlignment="Center" />
                            <Button Content="✕" Click="SideClose_Click" Style="{StaticResource ToolButton}"
                                    HorizontalAlignment="Right" Margin="0" Padding="7,1" FontSize="11"
                                    ToolTip="{loc:Str Side.CollapseTip}" />
                        </Grid>

                        <!-- Вкладки треков: при одном открытом ролике выбирать не из чего,
                             и переключатель прячется целиком (задача #32) -->
                        <StackPanel x:Name="SideTabs" Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="TabA" Style="{StaticResource TrackTab}" GroupName="SideTrack"
                                         Content="A" Checked="SideTab_Checked" Tag="A" />
                            <RadioButton x:Name="TabB" Style="{StaticResource TrackTab}" GroupName="SideTrack"
                                         Content="B" Checked="SideTab_Checked" Tag="B" />
                        </StackPanel>

                        <!-- Сведения -->
                        <StackPanel x:Name="InfoSection">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Info.File}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoFile"
                                           Style="{StaticResource PanelValue}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Info.Codec}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoCodec" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Info.Size}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoSize" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Str Info.Fps}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoFps" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Str Info.Mode}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoRate" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Str Info.Duration}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoDuration" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Str Info.Frames}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InfoFrames" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Str Info.Source}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InfoSource" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Str Info.Role}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="InfoRole" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:Str Info.Audio}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" x:Name="InfoAudio" Style="{StaticResource PanelValue}" />
                            </Grid>

                            <TextBlock x:Name="InfoProxyNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />

                            <TextBlock x:Name="InfoVfrNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"
                                       Text="{loc:Str Info.VfrNote}" />
                        </StackPanel>

                        <!-- Кэш кадров -->
                        <StackPanel x:Name="CacheSection" Visibility="Collapsed">
                            <TextBlock Text="{loc:Str Cache.ModeHeader}" Style="{StaticResource PanelHeader}" />

                            <RadioButton x:Name="RbAuto" Style="{StaticResource CacheRadio}"
                                         Content="{loc:Str Cache.Auto}" Checked="CacheMode_Checked" Tag="Auto" />
                            <TextBlock x:Name="RbAutoHint" Style="{StaticResource PanelHint}" />

                            <RadioButton x:Name="RbAlways" Style="{StaticResource CacheRadio}"
                                         Content="{loc:Str Cache.Always}"
                                         Checked="CacheMode_Checked" Tag="Always" />

                            <RadioButton x:Name="RbNever" Style="{StaticResource CacheRadio}"
                                         Content="{loc:Str Cache.Never}"
                                         Checked="CacheMode_Checked" Tag="Never" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                            <TextBlock Text="{loc:Str Cache.FpsHeader}" Style="{StaticResource PanelHeader}" />
                            <WrapPanel x:Name="CacheFpsChips">
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="0"
                                             Content="{loc:Str Cache.FpsSource}" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="60"
                                             Content="60" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="50"
                                             Content="50" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="30"
                                             Content="30" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="25"
                                             Content="25" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="24"
                                             Content="24" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="15"
                                             Content="15" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="12"
                                             Content="12" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="10"
                                             Content="10" Checked="CacheFps_Checked" />
                                <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="5"
                                             Content="5" Checked="CacheFps_Checked" />
                            </WrapPanel>
                            <TextBlock x:Name="CacheFpsHint" Style="{StaticResource PanelHint}" Margin="0,1,0,4"
                                       Text="{loc:Str Cache.FpsHint}" />

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                            <TextBlock x:Name="CacheFileHeader" Style="{StaticResource PanelHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Cache.FileMode}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CacheFileMode" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Cache.FileStep}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CacheFileStep" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Cache.FileProxy}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheFileProxy" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Str Cache.FileBuilt}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CacheFileBuilt" Style="{StaticResource PanelValue}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Str Cache.FileAudio}" Style="{StaticResource PanelKey}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CacheFileAudio" Style="{StaticResource PanelValue}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnRebuild" Style="{StaticResource ToolButton}"
                                        Content="{loc:Str Cache.Rebuild}" Click="CacheRebuild_Click" />
                                <Button x:Name="BtnUseSource" Style="{StaticResource ToolButton}"
                                        Content="{loc:Str Cache.UseSource}" Click="CacheUseSource_Click" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                            <TextBlock Text="{loc:Str Cache.StorageHeader}" Style="{StaticResource PanelHeader}" />
                            <TextBlock x:Name="CacheStorageText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,7" />
                            <ProgressBar x:Name="CacheStorageBar" Style="{StaticResource CacheProgressBar}" Value="0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ToolButton}" Content="{loc:Str Cache.OpenFolder}" Click="CacheOpenFolder_Click" />
                                <Button Style="{StaticResource ToolButton}" Content="{loc:Str Cache.ClearAll}" Click="CacheClear_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Таймлайн: панель управления и сам контрол (линейка, дорожки, playhead).
             В компактном виде (задача #18) вся эта область скрыта, вместо неё —
             подвал строкой ниже. Скрыта и в разметке: приложение всегда запускается
             компактным, и видимый в первом кадре таймлайн тут же схлопывался бы
             (задача #37). -->
        <Grid x:Name="TimelineArea" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1" Padding="12,6">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnZoomOut" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoZoomOut}" Click="ZoomOut_Click" ToolTip="{loc:Str Timeline.ZoomOut}" />
                    <TextBlock x:Name="TxtZoom" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" MinWidth="76"
                               TextAlignment="Center" />
                    <Button x:Name="BtnZoomIn" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoZoomIn}" Click="ZoomIn_Click" ToolTip="{loc:Str Timeline.ZoomIn}" />
                    <Button x:Name="BtnFit" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoFitWidth}" Click="Fit_Click"
                            ToolTip="{loc:Str Timeline.Fit}" />
                    <Button x:Name="BtnSnap" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoMagnet}" Click="Snap_Click"
                            ToolTip="{loc:Str Timeline.Snap}" />

                    <Border Width="1" Margin="4,2,10,2" Background="{StaticResource LineBrush}" />

                    <!-- Мастер-трек таблеткой: раньше кнопка назначала мастером активный
                         трек, и чтобы выбрать второй, приходилось сперва переключать
                         активный. Здесь трек выбирается прямо (задача #32). -->
                    <Path Data="{StaticResource IcoMaster}" Stretch="Uniform" Width="15" Height="15"
                          Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="1.5"
                          StrokeLineJoin="Round" Stroke="{StaticResource MutedBrush}"
                          ToolTip="{loc:Str Timeline.Master}" />
                    <Border x:Name="MasterPill" Style="{StaticResource SegPill}"
                            ToolTip="{loc:Str Timeline.Master}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SegMasterA" Style="{StaticResource SegText}" GroupName="Master"
                                         Content="A" Checked="Master_Checked" />
                            <RadioButton x:Name="SegMasterB" Style="{StaticResource SegText}" GroupName="Master"
                                         Content="B" Tag="{StaticResource TrackBBrush}" Checked="Master_Checked" />
                        </StackPanel>
                    </Border>

                    <!-- Сдвиг второго трека: перетаскивание клипа задаёт его грубо,
                         это поле и Alt+стрелки — покадрово -->
                    <Path Data="{StaticResource IcoOffset}" Stretch="Uniform" Width="16" Height="16"
                          Margin="6,0,6,0" VerticalAlignment="Center" StrokeThickness="1.5"
                          StrokeLineJoin="Round" Stroke="{StaticResource TrackBBrush}"
                          ToolTip="{loc:Str Timeline.Offset}" />
                    <Button x:Name="BtnOffsetDown" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoMinus}" Margin="0,0,4,0" Click="OffsetDown_Click"
                            ToolTip="{loc:Str Timeline.OffsetDown}" />
                    <TextBox x:Name="TxtOffset" Style="{StaticResource SpeedBox}" Text="0" Width="62"
                             Foreground="{StaticResource TrackBBrush}" CaretBrush="{StaticResource TrackBBrush}"
                             KeyDown="Offset_KeyDown" LostFocus="Offset_LostFocus"
                             ToolTip="{loc:Str Timeline.OffsetBox}" />
                    <Button x:Name="BtnOffsetUp" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoPlus}" Margin="4,0,6,0" Click="OffsetUp_Click"
                            ToolTip="{loc:Str Timeline.OffsetUp}" />
                    <Button x:Name="BtnOffsetReset" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoReset}" Click="OffsetReset_Click"
                            ToolTip="{loc:Str Timeline.OffsetReset}" />

                    <Button x:Name="BtnCollapse" DockPanel.Dock="Right" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoCollapse}" Margin="10,0,0,0" Click="ToggleCompact_Click"
                            ToolTip="{loc:Str Timeline.Collapse}" />

                    <TextBlock x:Name="TxtSegment" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="BtnLoop" DockPanel.Dock="Right" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoLoop}" Margin="0" Click="Loop_Click"
                            ToolTip="{loc:Str Timeline.Loop}" />
                    <Button x:Name="BtnSegReset" DockPanel.Dock="Right" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoReset}" Click="SegmentReset_Click"
                            ToolTip="{loc:Str Timeline.SegReset}" />
                    <Button x:Name="BtnOut" DockPanel.Dock="Right" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoSegmentOut}" Click="SetOut_Click"
                            ToolTip="{loc:Str Timeline.SegOut}" />
                    <Button x:Name="BtnIn" DockPanel.Dock="Right" Style="{StaticResource TimelineIconButton}"
                            Tag="{StaticResource IcoSegmentIn}" Click="SetIn_Click"
                            ToolTip="{loc:Str Timeline.SegIn}" />
                </DockPanel>
            </Border>

            <tl:TimelineControl x:Name="Timeline" Grid.Row="1" Margin="12,0,12,4" />
        </Grid>

        <!-- Компактный подвал (задача #18): полоса прогресса во всю ширину, под ней
             полоска инициализации кэша и ужатый транспорт. Заменяет собой и таймлайн,
             и полноразмерный транспорт, и строку сообщений. -->
        <Border x:Name="CompactFooter" Grid.Row="4"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8,12,6">
            <StackPanel>
                <tl:CompactBar x:Name="MiniBar" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTimeMini" FontFamily="{StaticResource MonoFont}" FontSize="13.5"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDurationMini" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnShuttleBackMini" Style="{StaticResource MiniGlyphButton}"
                                Tag="{StaticResource IcoShuttleBack}"
                                Click="ShuttleBack_Click" ToolTip="{loc:Str Transport.ShuttleBack}" />
                        <Button x:Name="BtnPrevMini" Style="{StaticResource MiniGlyphButton}"
                                Tag="{StaticResource IcoStepPrev}"
                                Click="StepPrev_Click" ToolTip="{loc:Str Transport.StepPrev}" />
                        <Button x:Name="BtnPlayMini" Style="{StaticResource MiniPlayGlyphButton}"
                                Tag="{StaticResource IcoPlay}"
                                Click="PlayPause_Click" ToolTip="{loc:Str Transport.Play}" />
                        <Button x:Name="BtnNextMini" Style="{StaticResource MiniGlyphButton}"
                                Tag="{StaticResource IcoStepNext}"
                                Click="StepNext_Click" ToolTip="{loc:Str Transport.StepNext}" />
                        <Button x:Name="BtnShuttleFwdMini" Style="{StaticResource MiniGlyphButton}"
                                Tag="{StaticResource IcoShuttleFwd}"
                                Click="ShuttleForward_Click" ToolTip="{loc:Str Transport.ShuttleFwd}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFrameAMini" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="TxtFrameBMini" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TrackBBrush}" />
                        <!-- Звук и в свёрнутом виде правится целиком: громкость нужна не
                             реже транспорта, а разворачивать таймлайн ради неё незачем -->
                        <Button x:Name="BtnMuteMini" Style="{StaticResource MiniIconButton}"
                                Tag="{StaticResource IcoVolume}" Margin="10,0,6,0" Click="Mute_Click"
                                ToolTip="{loc:Str Transport.Mute}" />
                        <Slider x:Name="VolumeSliderMini" Style="{StaticResource VolumeSlider}" Width="72"
                                ValueChanged="Volume_Changed"
                                ToolTip="{loc:Str Transport.Volume}" />
                        <TextBlock x:Name="TxtVolumeMini" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="34"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Button x:Name="BtnExpand" Style="{StaticResource MiniIconButton}"
                                Tag="{StaticResource IcoExpand}" Margin="10,0,0,0" Click="ToggleCompact_Click"
                                ToolTip="{loc:Str Timeline.Expand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Транспорт.
             WrapPanel, а не StackPanel: с появлением громкости (задача #20) содержимое
             перестало помещаться в окно наименьшей ширины, а обрезанный ползунок хуже
             перенесённого на вторую строку. -->
        <WrapPanel x:Name="TransportRow" Grid.Row="5" Orientation="Horizontal" Margin="14,10,14,12"
                   VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="BtnShuttleBack" Style="{StaticResource GlyphButton}"
                    Tag="{StaticResource IcoShuttleBack}"
                    Click="ShuttleBack_Click" ToolTip="{loc:Str Transport.ShuttleBackFull}" />
            <Button x:Name="BtnPrev" Style="{StaticResource GlyphButton}" Tag="{StaticResource IcoStepPrev}"
                    Click="StepPrev_Click" ToolTip="{loc:Str Transport.StepPrevFull}" />
            <Button x:Name="BtnPlay" Style="{StaticResource PlayGlyphButton}" Tag="{StaticResource IcoPlay}"
                    Click="PlayPause_Click" ToolTip="{loc:Str Transport.PlayFull}" />
            <Button x:Name="BtnNext" Style="{StaticResource GlyphButton}" Tag="{StaticResource IcoStepNext}"
                    Click="StepNext_Click" ToolTip="{loc:Str Transport.StepNextFull}" />
            <Button x:Name="BtnShuttleFwd" Style="{StaticResource GlyphButton}"
                    Tag="{StaticResource IcoShuttleFwd}"
                    Click="ShuttleForward_Click" ToolTip="{loc:Str Transport.ShuttleFwdFull}" />

            <!-- «В начало» — команда транспорта, и стоять ей рядом с шагом, а не
                 в конце строки среди прочего (задача #32) -->
            <Button x:Name="BtnStart" Style="{StaticResource GlyphButton}" Tag="{StaticResource IcoToStart}"
                    Click="ToStart_Click" ToolTip="{loc:Str Transport.ToStart}" />

            <TextBlock x:Name="TxtTime" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="19" />
            <TextBlock x:Name="TxtDuration" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="14"
                       Foreground="{StaticResource DimBrush}" />

            <Border x:Name="FrameBadgeA" Margin="14,0,0,0" Padding="8,2" CornerRadius="4"
                    BorderBrush="{StaticResource AccentDim}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFrameA" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
            <Border x:Name="FrameBadgeB" Margin="8,0,0,0" Padding="8,2" CornerRadius="4"
                    BorderBrush="{StaticResource TrackBDim}" BorderThickness="1" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtFrameB" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource TrackBBrush}" />
            </Border>

            <!-- Скорость воспроизведения: на шаг и seek не влияет, только на ход
                 воспроизведения; задаётся обоим трекам одинаковой. -->
            <Path Data="{StaticResource IcoSpeed}" Stretch="Uniform" Width="16" Height="16"
                  Margin="12,0,8,0" VerticalAlignment="Center" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Stroke="{StaticResource MutedBrush}"
                  ToolTip="{loc:Str Transport.Speed}" />
            <Button x:Name="BtnSpeedDown" Style="{StaticResource TimelineIconButton}"
                    Tag="{StaticResource IcoMinus}" Margin="0,0,4,0" Click="SpeedDown_Click"
                    ToolTip="{loc:Str Transport.SpeedDown}" />
            <TextBox x:Name="TxtSpeed" Style="{StaticResource SpeedBox}" Text="1"
                     KeyDown="Speed_KeyDown" LostFocus="Speed_LostFocus"
                     ToolTip="{loc:Str Transport.SpeedBox}" />
            <Button x:Name="BtnSpeedUp" Style="{StaticResource TimelineIconButton}"
                    Tag="{StaticResource IcoPlus}" Margin="4,0,0,0" Click="SpeedUp_Click"
                    ToolTip="{loc:Str Transport.SpeedUp}" />

            <!-- Звук (задача #20): звучит только мастер-трек, ведомый приглушён всегда,
                 иначе два ролика накладывались бы друг на друга. -->
            <Button x:Name="BtnMute" Style="{StaticResource TimelineIconButton}"
                    Tag="{StaticResource IcoVolume}" Margin="14,0,8,0" Click="Mute_Click"
                    ToolTip="{loc:Str Transport.Mute}" />
            <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="96"
                    ValueChanged="Volume_Changed"
                    ToolTip="{loc:Str Transport.Volume}" />
            <TextBlock x:Name="TxtVolume" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"
                       FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       Foreground="{StaticResource MutedBrush}" />
        </WrapPanel>

        <!-- Полоса полноэкранного режима (задача #28).
             Отдельное окно (Popup), а не элемент этой сетки: кадр выводит FlyleafHost
             в собственные окна поверх WPF, и обычная накладка главного окна оказалась
             бы под ним. Выезжает снизу на движение мыши и уезжает по бездействию —
             в полноэкранном виде это единственный доступный транспорт. -->
        <Popup x:Name="FsPopup" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
               AllowsTransparency="True" Focusable="False" StaysOpen="True" IsOpen="False">
            <Border x:Name="FsBar" Background="#E60F1119" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="16,8,16,10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FsSlide" />
                </Border.RenderTransform>
                <StackPanel>
                    <tl:CompactBar x:Name="FsProgress" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTimeFs" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtDurationFs" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource DimBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnShuttleBackFs" Style="{StaticResource MiniGlyphButton}"
                                    Tag="{StaticResource IcoShuttleBack}"
                                    Click="ShuttleBack_Click" ToolTip="{loc:Str Transport.ShuttleBack}" />
                            <Button x:Name="BtnPrevFs" Style="{StaticResource MiniGlyphButton}"
                                    Tag="{StaticResource IcoStepPrev}"
                                    Click="StepPrev_Click" ToolTip="{loc:Str Transport.StepPrev}" />
                            <Button x:Name="BtnPlayFs" Style="{StaticResource MiniPlayGlyphButton}"
                                    Tag="{StaticResource IcoPlay}"
                                    Click="PlayPause_Click" ToolTip="{loc:Str Transport.Play}" />
                            <Button x:Name="BtnNextFs" Style="{StaticResource MiniGlyphButton}"
                                    Tag="{StaticResource IcoStepNext}"
                                    Click="StepNext_Click" ToolTip="{loc:Str Transport.StepNext}" />
                            <Button x:Name="BtnShuttleFwdFs" Style="{StaticResource MiniGlyphButton}"
                                    Tag="{StaticResource IcoShuttleFwd}"
                                    Click="ShuttleForward_Click" ToolTip="{loc:Str Transport.ShuttleFwd}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFrameAFs" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="TxtFrameBFs" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource TrackBBrush}" />
                            <Button x:Name="FsScale" Style="{StaticResource MiniIconButton}"
                                    Tag="{StaticResource IcoScaleFit}" Margin="12,0,0,0" Click="Scale_Click"
                                    ToolTip="{loc:Str Toolbar.ScaleTip}" />
                            <Button x:Name="BtnExitFs" Style="{StaticResource MiniIconButton}"
                                    Tag="{StaticResource IcoExitFullscreen}" Margin="6,0,0,0"
                                    Click="FullScreen_Click"
                                    ToolTip="{loc:Str Transport.ExitFullscreen}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Строка сообщений: в компактном виде скрыта вместе с таймлайном -->
        <Border x:Name="StatusBar" Grid.Row="6" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,7"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtStatus" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</chrome:AppWindow>
