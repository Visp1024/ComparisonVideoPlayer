<Window x:Class="ComparisonPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:tl="clr-namespace:ComparisonPlayer.Timeline"
        Title="ComparisonVideoPlayer" Height="760" Width="1240"
        MinHeight="480" MinWidth="900"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnOpen" Style="{StaticResource PrimaryButton}" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Открыть файл" />
                        <TextBlock Text="Ctrl+O" Margin="8,0,0,0" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource ToolButton}" Content="Закрыть" Click="Close_Click" />
                <Button x:Name="BtnInfo" Style="{StaticResource ToolButton}" Content="Сведения" Click="Info_Click"
                        ToolTip="Сведения о файле поверх кадра (Ctrl+I)" />

                <!-- Кэш кадров: индикатор режима и панель управления -->
                <Button x:Name="BtnCache" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Content="Кэш…" Margin="8,0,0,0" Click="Cache_Click"
                        ToolTip="Режим кэша кадров, объём хранилища (C)" />

                <Button x:Name="BtnBuildCancel" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Content="Отменить" Margin="8,0,0,0" Visibility="Collapsed" Click="CacheCancel_Click"
                        ToolTip="Остановить сборку кэша" />

                <Border x:Name="ModeBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModeDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource DimBrush}" />
                        <TextBlock x:Name="ModeText" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Text="файл не открыт" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Кадр; панель сведений всплывает поверх него -->
        <Grid Grid.Row="1">
            <Border Background="{StaticResource VideoBrush}">
                <fl:FlyleafHost x:Name="VideoHost"
                                VideoBackground="{StaticResource VideoBrush}"
                                KeyBindings="None" OpenOnDrop="None" SwapOnDrop="None"
                                ToggleFullScreenOnDoubleClick="None">
                    <!-- Содержимое FlyleafHost живёт в окне-накладке поверх поверхности вывода -->
                    <Grid x:Name="OverlayRoot" Background="Transparent" AllowDrop="True">

                        <!-- Пустое состояние: непрозрачное, чтобы не просвечивал последний кадр -->
                        <Grid x:Name="EmptyState" Background="{StaticResource VideoBrush}">
                            <Border x:Name="DropFrame" Margin="18" CornerRadius="6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropTitle" Text="Перетащите видео сюда"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DropHint"
                                               Text="или нажмите «Открыть файл» · mp4, mkv, mov, avi, ts"
                                               FontSize="13" Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Таймкод поверх кадра, переключается клавишей T -->
                        <Border x:Name="Osd" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="14,12,0,0" Panel.ZIndex="1" CornerRadius="4" Padding="9,4"
                                Background="#A8050709" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OsdTime" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" Foreground="#F3F5FA" />
                                <TextBlock Text=" · " FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           Foreground="{StaticResource DimBrush}" />
                                <TextBlock x:Name="OsdFrame" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Сведения о файле: панель поверх кадра справа, по умолчанию свёрнута -->
                        <Border x:Name="InfoPanel" Width="250" HorizontalAlignment="Right"
                                Background="#F2161923" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1,0,0,0" Padding="14,12" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="С В Е Д Е Н И Я" Style="{StaticResource PanelHeader}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <Button Content="✕" Click="Info_Click" Style="{StaticResource ToolButton}"
                                            HorizontalAlignment="Right" Margin="0" Padding="7,1" FontSize="11"
                                            ToolTip="Свернуть (Ctrl+I)" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Файл" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoFile"
                                               Style="{StaticResource PanelValue}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Кодек" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoCodec" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Размер" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoSize" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Частота" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoFps" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Режим" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoRate" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Длительность" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoDuration" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Кадров" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InfoFrames" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Кадры из" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InfoSource" Style="{StaticResource PanelValue}" />
                                </Grid>

                                <TextBlock x:Name="InfoProxyNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />

                                <TextBlock x:Name="InfoVfrNote" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"
                                           Text="Переменная частота кадров: номер кадра вычисляется по времени и может отличаться от нумерации в других программах." />
                            </StackPanel>
                        </Border>
                        <!-- Панель «Кэш…»: накладка поверх кадра, как и «Сведения».
                             Обычное окно Popup здесь не годится — окна вывода FlyleafLib
                             перекрывают его, и панель не видна. -->
                        <Border x:Name="CachePanel" Width="360" HorizontalAlignment="Right" Visibility="Collapsed"
                                Background="#F2161923" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1,0,0,0" Padding="14,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="К Э Ш   К А Д Р О В" Style="{StaticResource PanelHeader}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <Button Content="✕" Click="Cache_Click" Style="{StaticResource ToolButton}"
                                            HorizontalAlignment="Right" Margin="0" Padding="7,1" FontSize="11"
                                            ToolTip="Свернуть (C)" />
                                </Grid>

                                <TextBlock Text="Р Е Ж И М   К Э Ш А" Style="{StaticResource PanelHeader}" />

                                <RadioButton x:Name="RbAuto" Style="{StaticResource CacheRadio}"
                                             Content="Автоматически" Checked="CacheMode_Checked" Tag="Auto" />
                                <TextBlock x:Name="RbAutoHint" Style="{StaticResource PanelHint}"
                                           Text="строить, если шаг назад медленнее 250 мс" />

                                <RadioButton x:Name="RbAlways" Style="{StaticResource CacheRadio}"
                                             Content="Всегда — для любого открытого файла"
                                             Checked="CacheMode_Checked" Tag="Always" />

                                <RadioButton x:Name="RbNever" Style="{StaticResource CacheRadio}"
                                             Content="Никогда — только прямой декод"
                                             Checked="CacheMode_Checked" Tag="Never" />

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                                <TextBlock Text="Ч А С Т О Т А   П Р О К С И" Style="{StaticResource PanelHeader}" />
                                <WrapPanel x:Name="CacheFpsChips">
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="0"
                                                 Content="как в исходнике" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="60"
                                                 Content="60" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="50"
                                                 Content="50" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="30"
                                                 Content="30" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="25"
                                                 Content="25" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="24"
                                                 Content="24" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="15"
                                                 Content="15" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="12"
                                                 Content="12" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="10"
                                                 Content="10" Checked="CacheFps_Checked" />
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="CacheFps" Tag="5"
                                                 Content="5" Checked="CacheFps_Checked" />
                                </WrapPanel>
                                <TextBlock x:Name="CacheFpsHint" Style="{StaticResource PanelHint}" Margin="0,1,0,4"
                                           Text="ниже исходной — кэш меньше и собирается быстрее, но кадры прореживаются, а их номера становятся номерами прокси" />

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,10" />

                                <TextBlock Text="Э Т О Т   Ф А Й Л" Style="{StaticResource PanelHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Режим" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CacheFileMode" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг назад" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CacheFileStep" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Прокси" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheFileProxy" Style="{StaticResource PanelValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Собран" Style="{StaticResource PanelKey}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CacheFileBuilt" Style="{StaticResource PanelValue}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnRebuild" Style="{StaticResource ToolButton}"
                                            Content="Собрать заново" Click="CacheRebuild_Click" />
                                    <Button x:Name="BtnUseSource" Style="{StaticResource ToolButton}"
                                            Content="Играть с исходника" Click="CacheUseSource_Click" />
                                </StackPanel>

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                                <TextBlock Text="Х Р А Н И Л И Щ Е" Style="{StaticResource PanelHeader}" />
                                <TextBlock x:Name="CacheStorageText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,7" />
                                <ProgressBar x:Name="CacheStorageBar" Style="{StaticResource CacheProgressBar}" Value="0" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource ToolButton}" Content="Открыть папку" Click="CacheOpenFolder_Click" />
                                    <Button Style="{StaticResource ToolButton}" Content="Очистить всё" Click="CacheClear_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                                    </Border>
                    </Grid>
                </fl:FlyleafHost>
            </Border>
        </Grid>

        <!-- Таймлайн фазы 2: панель управления и сам контрол (линейка, клип, playhead).
             Он заменил собой шкалу позиции фазы 1 и полоску миниатюр фазы 4. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1" Padding="12,6">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnZoomOut" Style="{StaticResource TimelineButton}" Content="−"
                            Click="ZoomOut_Click" ToolTip="Отдалить (−)" />
                    <TextBlock x:Name="TxtZoom" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" MinWidth="76" />
                    <Button x:Name="BtnZoomIn" Style="{StaticResource TimelineButton}" Content="+"
                            Click="ZoomIn_Click" ToolTip="Приблизить (+)" />
                    <Button x:Name="BtnFit" Style="{StaticResource TimelineButton}" Content="Уместить"
                            Click="Fit_Click" ToolTip="Весь ролик в ширину окна (F)" />
                    <Button x:Name="BtnSnap" Style="{StaticResource TimelineButton}" Content="Снэп"
                            Click="Snap_Click" ToolTip="Притягивать playhead и ручки к границам (S)" />

                    <TextBlock x:Name="TxtSegment" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="BtnLoop" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Петля" Margin="0" Click="Loop_Click"
                            ToolTip="Повторять отрезок при воспроизведении (L)" />
                    <Button x:Name="BtnSegReset" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Сбросить" Click="SegmentReset_Click"
                            ToolTip="Отрезок на весь ролик (Shift+I)" />
                    <Button x:Name="BtnOut" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Конец отрезка" Click="SetOut_Click"
                            ToolTip="Конец отрезка на текущем кадре (O)" />
                    <Button x:Name="BtnIn" DockPanel.Dock="Right" Style="{StaticResource TimelineButton}"
                            Content="Начало отрезка" Click="SetIn_Click"
                            ToolTip="Начало отрезка на текущем кадре (I)" />
                </DockPanel>
            </Border>

            <tl:TimelineControl x:Name="Timeline" Grid.Row="1" Margin="12,0,12,4" />
        </Grid>

        <!-- Транспорт -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,10,14,12" VerticalAlignment="Center">
            <Button x:Name="BtnPrev" Style="{StaticResource TransportButton}" Content="◀|" Click="StepPrev_Click"
                    ToolTip="Шаг на кадр назад (←)" />
            <Button x:Name="BtnPlay" Style="{StaticResource PlayButton}" Content="▶" Click="PlayPause_Click"
                    ToolTip="Воспроизведение / пауза (Space)" />
            <Button x:Name="BtnNext" Style="{StaticResource TransportButton}" Content="|▶" Click="StepNext_Click"
                    ToolTip="Шаг на кадр вперёд (→)" />

            <TextBlock x:Name="TxtTime" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="19" />
            <TextBlock x:Name="TxtDuration" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="14"
                       Foreground="{StaticResource DimBrush}" />

            <Border x:Name="FrameBadge" Margin="14,0,0,0" Padding="8,2" CornerRadius="4"
                    BorderBrush="{StaticResource AccentDim}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFrame" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <Button x:Name="BtnStart" Style="{StaticResource ToolButton}" Content="В начало" Margin="16,0,0,0"
                    Click="ToStart_Click" ToolTip="Начало отрезка (Home); Shift+Home — первый кадр ролика" />

            <!-- Скорость воспроизведения: на шаг и seek не влияет, только на ход
                 воспроизведения. Поле правится и вручную — набор готовых значений
                 всё равно не покрыл бы «0,3×» для разбора быстрого движения. -->
            <TextBlock Text="скорость" Margin="10,0,8,0" VerticalAlignment="Center"
                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
            <Button x:Name="BtnSpeedDown" Style="{StaticResource TimelineButton}" Content="−"
                    Margin="0,0,4,0" Click="SpeedDown_Click" ToolTip="Медленнее на 0,25×" />
            <TextBox x:Name="TxtSpeed" Style="{StaticResource SpeedBox}" Text="1"
                     KeyDown="Speed_KeyDown" LostFocus="Speed_LostFocus"
                     ToolTip="Скорость воспроизведения: введите число и нажмите Enter" />
            <Button x:Name="BtnSpeedUp" Style="{StaticResource TimelineButton}" Content="+"
                    Margin="4,0,0,0" Click="SpeedUp_Click" ToolTip="Быстрее на 0,25×" />
        </StackPanel>

        <!-- Строка сообщений -->
        <Border Grid.Row="4" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="TxtStatus" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
