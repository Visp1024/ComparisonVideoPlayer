<chrome:AppWindow x:Class="ComparisonPlayer.Export.ExportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:chrome="clr-namespace:ComparisonPlayer.Chrome"
                  xmlns:loc="clr-namespace:ComparisonPlayer.Localization"
                  Title="{loc:Str Export.Title}" Icon="/app.ico"
                  Width="560" SizeToContent="Height" ResizeMode="NoResize"
                  WindowStartupLocation="CenterOwner"
                  Background="{StaticResource PanelBrush}"
                  Foreground="{StaticResource TextBrush}"
                  FontFamily="Segoe UI" FontSize="14"
                  UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <chrome:TitleBar Grid.Row="0" ShowResizeButtons="False" Caption="{loc:Str Export.Caption}" />

        <StackPanel Grid.Row="1" Margin="18,16,18,14">
            <TextBlock x:Name="TxtHead" Text="{loc:Str Export.Head}"
                       FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- Что именно режем: трек, границы и исходник видны до начала работы,
                 а не постфактум в имени готового файла -->
            <Border x:Name="PanelFacts" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,9" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Export.Track}" Style="{StaticResource PanelKey}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTrack"
                               Foreground="{StaticResource TextBrush}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,5"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Export.Range}" Style="{StaticResource PanelKey}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRange"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Export.Length}" Style="{StaticResource PanelKey}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtLength"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Str Export.Source}" Style="{StaticResource PanelKey}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSource"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,0" />
                </Grid>
            </Border>

            <StackPanel x:Name="PanelMode" Margin="0,0,0,14">
                <TextBlock Text="{loc:Str Export.ModeHeader}" Style="{StaticResource PanelHeader}" Margin="0,0,0,7" />
                <WrapPanel>
                    <RadioButton x:Name="ChipPrecise" Style="{StaticResource ChipToggle}" GroupName="ExportMode"
                                 Content="{loc:Str Export.ModePrecise}" IsChecked="True" Checked="Mode_Checked" />
                    <RadioButton x:Name="ChipCopy" Style="{StaticResource ChipToggle}" GroupName="ExportMode"
                                 Content="{loc:Str Export.ModeCopy}" Checked="Mode_Checked" />
                </WrapPanel>
                <TextBlock x:Name="TxtModeHint" Style="{StaticResource PanelHint}" Margin="0,1,0,0" />
            </StackPanel>

            <TextBlock Text="{loc:Str Export.FileHeader}" Style="{StaticResource PanelHeader}" Margin="0,0,0,7" />
            <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                <DockPanel>
                    <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Padding="10,2" FontSize="12" Content="{loc:Str Export.Browse}" Click="Browse_Click" />
                    <!-- Путь длинный и обрезается: полный показываем подсказкой -->
                    <TextBlock x:Name="TxtPath" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
            </Border>

            <ProgressBar x:Name="Bar" Style="{StaticResource CacheProgressBar}"
                         Visibility="Collapsed" Margin="0,10,0,8" />
            <!-- Место под подпись держим постоянным: без этого окно прыгало бы по высоте
                 на каждой смене состояния (SizeToContent) -->
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12.5" MinHeight="34"
                       Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnPrimary" Style="{StaticResource PrimaryButton}"
                        Padding="16,6" IsDefault="True" Content="{loc:Str Export.Run}" Click="Primary_Click" />
                <!-- Появляется только у готового файла: до него показывать нечего -->
                <Button x:Name="BtnReveal" Style="{StaticResource ToolButton}" Visibility="Collapsed"
                        Padding="16,6" Content="{loc:Str Export.Reveal}" Click="Reveal_Click" />
                <!-- Не IsCancel: во время работы эта кнопка снимает ffmpeg, а не закрывает окно -->
                <Button x:Name="BtnSecondary" Style="{StaticResource ToolButton}" Margin="0"
                        Padding="16,6" Content="{loc:Str Export.Cancel}" Click="Secondary_Click" />
            </StackPanel>
        </Border>
    </Grid>
</chrome:AppWindow>
