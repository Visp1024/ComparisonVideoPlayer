<chrome:AppWindow x:Class="ComparisonPlayer.FFmpegSetupWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:chrome="clr-namespace:ComparisonPlayer.Chrome"
                  xmlns:loc="clr-namespace:ComparisonPlayer.Localization"
                  Title="{loc:Str Setup.Title}" Icon="/app.ico"
                  Width="600" SizeToContent="Height" ResizeMode="NoResize"
                  WindowStartupLocation="CenterScreen"
                  Background="{StaticResource PanelBrush}"
                  Foreground="{StaticResource TextBrush}"
                  FontFamily="Segoe UI" FontSize="14"
                  UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <chrome:TitleBar Grid.Row="0" ShowResizeButtons="False" Caption="{loc:Str Setup.Caption}" />

        <StackPanel Grid.Row="1" Margin="18,16,18,14">
            <TextBlock Text="{loc:Str Setup.Head}"
                       FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       FontSize="13.5" Margin="0,0,0,12"
                       Text="{loc:Str Setup.Intro}" />

            <!-- Куда именно ляжет комплект: путь виден до начала загрузки, а не постфактум -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Setup.DirLabel}" Foreground="{StaticResource DimBrush}"
                           FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                <!-- Путь длинный и обрезается: полный показываем подсказкой -->
                <TextBlock Grid.Column="1" x:Name="TxtTarget" Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>

            <ProgressBar x:Name="Bar" Style="{StaticResource CacheProgressBar}"
                         Visibility="Collapsed" Margin="0,0,0,8" />
            <!-- Место под подпись держим постоянным: без этого окно прыгало бы по высоте
                 на каждой смене состояния (SizeToContent) -->
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12.5" MinHeight="34"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButton}"
                        Padding="16,6" IsDefault="True" Click="Install_Click" />
                <!-- Не IsCancel: во время загрузки эта кнопка отменяет её, а не закрывает окно -->
                <Button x:Name="BtnCancel" Style="{StaticResource ToolButton}" Margin="0"
                        Padding="16,6" Content="{loc:Str Setup.NotNow}" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</chrome:AppWindow>
