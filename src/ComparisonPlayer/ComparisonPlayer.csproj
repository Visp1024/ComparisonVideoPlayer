<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Определение VFR читает AVStream напрямую из FFmpeg-биндингов -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ComparisonPlayer</AssemblyName>
    <RootNamespace>ComparisonPlayer</RootNamespace>
    <!-- Версия поставки: её же берут tools/publish.ps1 (имя архива) и инсталлятор -->
    <Version>1.0.3</Version>
    <Product>CVP</Product>
    <Description>Покадровое сравнение двух видео</Description>
    <Company>CVP</Company>
    <Copyright>© 2026</Copyright>
    <!-- Иконка exe; генерируется из docs/app-icon.svg через tools/make-app-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Холодный старт (задача #31). Почти всё время до окна уходило на JIT: без
         предкомпиляции разбор XAML главного окна и создание плееров компилируются
         на месте при каждом запуске. Замер серией (tools/measure-startup.ps1):
         1383 → 1110 мс. Платим размером поставки — образ R2R крупнее. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlyleafLib" Version="3.10.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Та же иконка как ресурс — для заголовка окна и панели задач -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
