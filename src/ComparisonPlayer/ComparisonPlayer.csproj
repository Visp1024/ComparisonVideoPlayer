<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Определение VFR читает AVStream напрямую из FFmpeg-биндингов -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ComparisonPlayer</AssemblyName>
    <RootNamespace>ComparisonPlayer</RootNamespace>
    <!-- Иконка exe; генерируется из docs/app-icon.svg через tools/make-app-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlyleafLib" Version="3.10.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Та же иконка как ресурс — для заголовка окна и панели задач -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
