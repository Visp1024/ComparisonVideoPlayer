<chrome:AppWindow x:Class="ComparisonPlayer.Chrome.MessageDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:chrome="clr-namespace:ComparisonPlayer.Chrome"
                  xmlns:loc="clr-namespace:ComparisonPlayer.Localization"
                  Icon="/app.ico" Width="440" SizeToContent="Height"
                  MinHeight="150" ResizeMode="NoResize" ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner"
                  Background="{StaticResource PanelBrush}"
                  Foreground="{StaticResource TextBrush}"
                  FontFamily="Segoe UI" FontSize="14"
                  UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <chrome:TitleBar x:Name="Bar" Grid.Row="0" ShowResizeButtons="False" />

        <StackPanel Grid.Row="1" Margin="18,16,18,14">
            <TextBlock x:Name="TxtMessage" FontSize="13.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="TxtDetail" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Button Style="{StaticResource PrimaryButton}" Margin="0" HorizontalAlignment="Right"
                    Content="{loc:Str Dialog.Ok}" Click="Ok_Click" IsDefault="True" IsCancel="True" />
        </Border>
    </Grid>
</chrome:AppWindow>
